# Editor (Next.js) required environment variables.
# The check-env-parity.sh preflight fails the deploy if any of these keys
# is missing from the target /app/editor/.env on the VPS.
#
# Keys listed UNCOMMENTED are required — the editor will not work without
# them. Commented keys are optional and fall back to code defaults.

# --- Firebase Auth (all required) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- AstraPBX server-to-server auth (required for admin-scoped routes) ---
INTERNAL_API_KEY=
GATEWAY_ADMIN_KEY=
ADMIN_USERNAME=
ADMIN_PASSWORD=

# --- Optional: code defaults kick in if unset ---
# NEXT_PUBLIC_GATEWAY_URL=http://localhost:7860
# NEXT_PUBLIC_PBX_URL=http://localhost:8000
# NEXT_PUBLIC_WORKFLOW_URL=http://localhost:3002
# NEXT_PUBLIC_SIP_HOST=sip.example.com
# NEXT_PUBLIC_SIP_PORT=5080
# NEXT_PUBLIC_ASTRADIAL_ENV=staging
# NEXT_PUBLIC_FB_AUTH_EMAIL=admin@example.com
# NEXT_PUBLIC_FB_AUTH_PASS=
