# ============================================
# Astradial OSS Configuration
# Copy this file: cp .env.example .env
# ============================================

# Mode: selfhosted | hosted | developer
ASTRADIAL_MODE=selfhosted

# ── Auth provider ─────────────────────────────────────────────────
# false (default): local mode — log in with org api_key + api_secret
#                  (no Firebase project needed)
# true:            Firebase mode — requires NEXT_PUBLIC_FIREBASE_* env
#                  vars (below) and a real Firebase project
USE_FIREBASE=false
NEXT_PUBLIC_USE_FIREBASE=false

# ── Database ──
DB_NAME=astradial
DB_USER=astradial
DB_PASSWORD=changeme
DB_ROOT_PASSWORD=changeme

# ── Security ──
# JWT_SECRET signs auth tokens; rotate it whenever you suspect compromise.
JWT_SECRET=change-this-to-a-random-string
# INTERNAL_API_KEY authenticates pipecat-flow → astrapbx internal calls.
# Generate fresh with: openssl rand -hex 24
INTERNAL_API_KEY=change-this-to-a-random-string

# ── Admin account (created on first boot) ──
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme
ADMIN_NAME=Admin

# ── Platform admin (for org management API) ──
ADMIN_USERNAME=admin
ADMIN_API_PASSWORD=admin

# ── Asterisk ──
ASTERISK_AMI_SECRET=astradial

# ── SIP Host (your server's LAN IP — needed for audio to work) ──
# Find it with: ifconfig | grep "inet 192"
# SIP_HOST=192.168.1.100

# ── Editor public env (Next.js) ──
# URL of your astrapbx API as reachable from a user's browser
NEXT_PUBLIC_PBX_URL=http://localhost:8000

# ── Firebase mode — only fill these in if USE_FIREBASE=true ──
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=
# Server-side service-account JSON path for Firebase Admin SDK
# (only needed when USE_FIREBASE=true)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/firebase-service-account.json

# ── Optional integrations (all env-gated; features hide if unset) ──
# MSG91 WhatsApp messaging — daily ticket alerts, admin WhatsApp config
# MSG91_ADMIN_AUTH_KEY=
# Google Cloud TTS for IVR greeting synthesis (uses GOOGLE_APPLICATION_CREDENTIALS)
# Google Cloud Storage for recordings (uses GOOGLE_APPLICATION_CREDENTIALS)
# GCS_BUCKET=

# ── Developer mode only (NOT for self-hosted prod) ──
# Get these from astradial.com/developers
# ASTRADIAL_TRUNK_HOST=pbx.astradial.com
# ASTRADIAL_TRUNK_USER=dev_your_username
# ASTRADIAL_TRUNK_PASS=your_password

# ── Integrations and Secrets (Private repository placeholders) ──
ELEVENLABS_API_KEY=
MSG91_ADMIN_AUTH_KEY=
MSG91_WEBHOOK_SECRET=
CAMPAIGN_WEBHOOK_SECRET=
DB_PASSWORD=
REDIS_PASSWORD=
